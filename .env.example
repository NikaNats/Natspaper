# Environment Variables Example
# Copy this file to .env.development or .env.production and fill in the actual values
# See .env.development and .env.production for environment-specific examples

# ===== REQUIRED: Build/Server Variables =====
SITE_WEBSITE=https://example.com

# ===== OPTIONAL: Environment Control =====
NODE_ENV=production
BUILD_TIMESTAMP=
BUILD_VERSION=

# ===== OPTIONAL: Analytics & SEO =====
PUBLIC_GOOGLE_SITE_VERIFICATION=

# ===== ANALYTICS NOTE =====
# This project uses Vercel Web Analytics (GDPR-compliant, no cookies)
# Google Analytics has been removed to ensure privacy compliance
# Vercel Analytics is automatically enabled when deployed to Vercel
# @see https://vercel.com/docs/analytics/privacy-and-compliance

# ===== OPTIONAL: Giscus Comments =====
# Get your values from: https://giscus.app/
PUBLIC_GISCUS_REPO=myusername/myrepo
PUBLIC_GISCUS_REPO_ID=R_...
PUBLIC_GISCUS_CATEGORY=Announcements
PUBLIC_GISCUS_CATEGORY_ID=DIC_...


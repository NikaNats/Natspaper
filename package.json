{
  "name": "natspaper",
  "type": "module",
  "version": "1.0.0",
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "build:tokens": "node scripts/build-tokens.js",
    "dev": "pnpm build:tokens && cross-env NODE_ENV=development astro dev",
    "generate-csp": "node scripts/generate-csp-hashes.js",
    "compress:zstd": "node scripts/compress-assets.js",
    "build": "pnpm build:tokens && cross-env NODE_ENV=production astro check && astro build && npm run generate-csp && npm run compress:zstd && npm run verify-build",
    "build:dev": "pnpm build:tokens && cross-env NODE_ENV=development astro check && astro build && npm run generate-csp && npm run compress:zstd && npm run verify-build",
    "build:prod": "pnpm build:tokens && cross-env NODE_ENV=production astro check && astro build && npm run generate-csp && npm run compress:zstd && npm run verify-build",
    "preview": "cross-env NODE_ENV=production astro preview",
    "verify-build": "node scripts/verify-build.js",
    "audit:apca": "node scripts/audit-apca.js",
    "sync": "astro sync",
    "astro": "astro",
    "format:check": "pnpm build:tokens && prettier --check .",
    "format": "pnpm build:tokens && prettier --write .",
    "lint": "pnpm build:tokens && eslint . && stylelint \"src/styles/**/*.css\"",
    "lint:style": "pnpm build:tokens && stylelint \"src/styles/**/*.css\"",
    "lint:style:fix": "pnpm build:tokens && stylelint \"src/styles/**/*.css\" --fix",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "pnpm build:tokens && vitest run",
    "test:coverage": "pnpm build:tokens && vitest run --coverage",
    "test:workflows": "vitest run tests/workflows",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:chrome": "playwright test --project=chromium",
    "test:all": "pnpm build:tokens && pnpm run audit:apca && pnpm test:run && pnpm test:e2e",
    "security:audit": "pnpm audit --audit-level=high",
    "prepare": "node scripts/build-tokens.js && husky"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.6",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "^11.0.20",
    "@expressive-code/plugin-collapsible-sections": "^0.44.3",
    "@expressive-code/plugin-line-numbers": "^0.44.3",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/noto-sans-georgian": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.5",
    "@vercel/analytics": "^2.0.1",
    "astro": "~7.4.7",
    "astro-expressive-code": "^0.44.3",
    "dayjs": "^1.11.23",
    "katex": "^0.19.1",
    "rehype-katex": "^7.0.1",
    "remark-collapse": "^0.1.2",
    "remark-math": "^6.0.0",
    "remark-toc": "^9.0.0",
    "satori": "^0.63.2",
    "satori-html": "^0.3.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@mongodb-js/zstandard": "file:./shims/zstandard",
    "@playwright/test": "^1.65.0",
    "@shikijs/transformers": "^4.6.0",
    "@tailwindcss/typography": "^0.5.20",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitest/coverage-v8": "5.1.0",
    "@vitest/ui": "^5.1.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "fzstd": "^0.1.1",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sonda": "^0.14.0",
    "stylelint": "^18.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.astro": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.css": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  }
}

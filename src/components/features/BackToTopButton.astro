---
import IconChevronLeft from "@/assets/icons/IconChevronLeft.svg";
import IconArrowNarrowUp from "@/assets/icons/IconArrowNarrowUp.svg";
import { FEATURES } from "@/config"; // Import configuration
---

<div
  id="btt-btn-container"
  data-threshold={FEATURES.backToTopThreshold}
  class:list={[
    "fixed end-4 bottom-8 z-50 transition-all duration-300 motion-reduce:transition-none",
    "md:sticky md:end-auto md:float-end md:me-1",
  ]}
>
  <button
    data-button="back-to-top"
    aria-label="Back to top of page"
    class:list={[
      "group relative bg-background px-2 py-1",
      "size-14 rounded-full shadow-xl",
      "md:h-8 md:w-fit md:rounded-md md:shadow-none md:focus-visible:rounded-none",
      "md:bg-background/35 md:bg-clip-padding md:backdrop-blur-lg",
    ]}
  >
    <span
      id="progress-indicator"
      class="absolute inset-0 -z-10 block size-14 scale-110 rounded-full bg-transparent md:hidden md:h-8 md:rounded-md"
    ></span>
    <IconChevronLeft
      class="inline-block rotate-90 md:hidden"
      aria-hidden="true"
    />
    <span class="sr-only text-sm group-hover:text-accent md:not-sr-only">
      <IconArrowNarrowUp class="inline-block size-4" aria-hidden="true" />
      Back To Top
    </span>
  </button>
</div>

<style>
  /*
   * W3C Scroll-driven Animations: the button reveal and the mobile radial
   * progress ring are driven by the scroll timeline on supporting engines
   * (compositor-side, no JS scroll handlers). --btt-progress must be a
   * registered custom property for the conic-gradient to animate.
   * The reveal keyframes mirror FEATURES.backToTopThreshold (0.3).
   */
  @property --btt-progress {
    syntax: "<percentage>";
    inherits: false;
    initial-value: 0%;
  }

  @keyframes btt-radial-fill {
    to {
      --btt-progress: 100%;
    }
  }

  @keyframes reveal-back-to-top {
    0%,
    25% {
      opacity: 0;
      transform: translateY(3.5rem);
      pointer-events: none;
    }
    35%,
    100% {
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }
  }

  /* Modern engines: pure CSS scroll timeline */
  @supports (animation-timeline: scroll()) {
    #btt-btn-container {
      animation: reveal-back-to-top linear both;
      animation-timeline: scroll(root block);
    }

    #progress-indicator {
      background-image: conic-gradient(
        var(--color-accent) var(--btt-progress),
        transparent var(--btt-progress)
      );
      animation: btt-radial-fill linear;
      animation-timeline: scroll(root block);
    }
  }

  /* Fallback for engines without CSS scroll timelines: JS sets data-visible */
  @supports not (animation-timeline: scroll()) {
    #btt-btn-container {
      opacity: 0;
      transform: translateY(3.5rem);
      pointer-events: none;
    }
    #btt-btn-container[data-visible="true"] {
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }
  }
</style>

<script is:inline data-astro-rerun>
  function initBackToTop() {
    const container = document.getElementById("btt-btn-container");
    if (!container || container.dataset.initialized) return;

    const button = container.querySelector("[data-button='back-to-top']");
    const progressIndicator = container.querySelector("#progress-indicator");
    const VISIBILITY_THRESHOLD = parseFloat(
      container.dataset.threshold || "0.3"
    );

    button.addEventListener("click", () => {
      // WCAG 2.3.3: Respect user's motion preference
      const prefersReducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;
      window.scrollTo({
        top: 0,
        behavior: prefersReducedMotion ? "instant" : "smooth",
      });
    });

    // Attach the JS scroll handler ONLY when scroll-driven animations are
    // unavailable (legacy engines, test runners). On modern engines the CSS
    // scroll timeline owns both the reveal and the radial fill.
    const hasNativeScrollTimeline =
      typeof CSS !== "undefined" &&
      CSS.supports &&
      CSS.supports("animation-timeline", "scroll()");

    if (!hasNativeScrollTimeline) {
      const handleScroll = () => {
        const { scrollTop, scrollHeight, clientHeight } =
          document.documentElement;
        const scrollTotal = scrollHeight - clientHeight;

        // Prevent division by zero on pages with no scroll
        if (scrollTotal <= 0) {
          container.dataset.visible = "false";
          return;
        }

        const scrollPercent = (scrollTop / scrollTotal) * 100;

        if (progressIndicator) {
          progressIndicator.style.backgroundImage = `conic-gradient(var(--accent) ${scrollPercent}%, transparent ${scrollPercent}%)`;
        }

        const isVisible = scrollTop / scrollTotal > VISIBILITY_THRESHOLD;
        container.dataset.visible = isVisible.toString();
      };

      // Performance: Use requestAnimationFrame for smooth scroll handling
      let ticking = false;
      document.addEventListener(
        "scroll",
        () => {
          if (!ticking) {
            window.requestAnimationFrame(() => {
              handleScroll();
              ticking = false;
            });
            ticking = true;
          }
        },
        { passive: true }
      );
    }

    // Mark as initialized to prevent re-attaching listeners on page transitions
    container.dataset.initialized = "true";
  }

  // Ensure script runs on initial load and after Astro's view transitions
  initBackToTop();
  document.addEventListener("astro:page-load", initBackToTop);
</script>

---
import { GISCUS, SITE } from "@/config";
// ?url imports emit fingerprinted files (cache-busting on every edit) and
// resolve to their public URLs. Fingerprinting matters here: giscus.app and
// edge CDNs cache theme CSS aggressively, so a content hash in the filename
// is the only reliable invalidation when the theme changes.
import giscusDarkUrl from "@/assets/giscus-dark.css?url";
import giscusLightUrl from "@/assets/giscus-light.css?url";

export interface Props {
  locale?: string;
}

const isEnabled =
  GISCUS.enabled && !!GISCUS.repo && !!GISCUS.repoId && !!GISCUS.categoryId;

const { locale = "en" } = Astro.props;

// Giscus does not support all languages (e.g. Georgian 'ka').
// Passing an unsupported lang causes the Giscus iframe to 404 and triggers a CSP block.
// Fall back to 'en' for any locale not in the supported set.
const SUPPORTED_GISCUS_LANGS = new Set([
  "ar",
  "ca",
  "de",
  "en",
  "es",
  "fa",
  "fr",
  "he",
  "hu",
  "id",
  "it",
  "ja",
  "kh",
  "ko",
  "nl",
  "pl",
  "pt",
  "ro",
  "ru",
  "th",
  "tr",
  "uk",
  "vi",
  "zh-CN",
  "zh-TW",
]);

const giscusLang = SUPPORTED_GISCUS_LANGS.has(locale) ? locale : "en";
const siteWebsite = SITE.website.replace(/\/$/, "");
---

{
  isEnabled && (
    <div
      class="giscus-wrapper"
      data-giscus-repo={GISCUS.repo}
      data-giscus-repo-id={GISCUS.repoId}
      data-giscus-category={GISCUS.category}
      data-giscus-category-id={GISCUS.categoryId}
      data-giscus-mapping={GISCUS.mapping}
      data-giscus-reactions-enabled={GISCUS.reactionsEnabled ? "1" : "0"}
      data-giscus-emit-metadata={GISCUS.emitMetadata ? "1" : "0"}
      data-giscus-input-position={GISCUS.inputPosition}
      data-giscus-lang={giscusLang}
      data-giscus-loading={GISCUS.loading}
      data-site-url={siteWebsite}
      data-giscus-dark-url={giscusDarkUrl}
      data-giscus-light-url={giscusLightUrl}
    >
      <div class="giscus" />
    </div>
  )
}

<script is:inline>
  /**
   * Giscus lazy-loader with academic theme synchronization.
   * - Defers ~150KB of JS until the comments section nears the viewport.
   * - Injects the resolved custom-CSS theme URL up front (no unstyled flash).
   * - Routes localhost theme fetches to the production origin, which
   *   giscus.app cannot reach on a private loopback address.
   * - Theme URLs carry no timestamp cache-buster so edge CDNs can cache them.
   */
  (function () {
    let giscusLoaded = false;

    function getThemeUrl(theme, wrapper) {
      const isLocal =
        window.location.hostname === "localhost" ||
        window.location.hostname === "127.0.0.1";

      // giscus.app runs on an external server and cannot access localhost URLs.
      // During development, fall back to the live domain so custom styles load properly.
      const productionOrigin = wrapper
        ? wrapper.dataset.siteUrl
        : "https://natspaper.vercel.app";
      const baseOrigin = isLocal ? productionOrigin : window.location.origin;
      // Fingerprinted asset paths (data attributes); the content hash in the
      // filename busts browser, edge, and giscus.app caches on every edit.
      const path =
        theme === "dark"
          ? wrapper.dataset.giscusDarkUrl
          : wrapper.dataset.giscusLightUrl;

      return `${baseOrigin}${path}`;
    }

    function getCurrentTheme() {
      return (
        document.documentElement.dataset.theme ||
        document.documentElement.getAttribute("data-theme") ||
        "light"
      );
    }

    function updateGiscusTheme(explicitTheme) {
      const wrapper = document.querySelector(".giscus-wrapper");
      if (!wrapper) return;
      const theme = explicitTheme || getCurrentTheme();
      const giscusTheme = getThemeUrl(theme, wrapper);
      const iframe = document.querySelector("iframe.giscus-frame");

      if (!iframe || !iframe.contentWindow) return;

      try {
        iframe.contentWindow.postMessage(
          { giscus: { setConfig: { theme: giscusTheme } } },
          "https://giscus.app"
        );
      } catch {
        // Suppress postMessage transport errors if iframe is navigating
      }
    }

    function loadGiscus() {
      if (giscusLoaded) return;
      const wrapper = document.querySelector(".giscus-wrapper");
      if (!wrapper) return;

      giscusLoaded = true;
      const theme = getCurrentTheme();
      const initialThemeUrl = getThemeUrl(theme, wrapper);

      const script = document.createElement("script");
      script.src = "https://giscus.app/client.js";
      // SECURITY: SRI hash ensures script integrity (generate new hash when updating Giscus)
      // To regenerate (PowerShell):
      //   Invoke-WebRequest https://giscus.app/client.js -OutFile client.js
      //   $hash = [System.Security.Cryptography.SHA384]::Create().ComputeHash((Get-Content client.js -AsByteStream))
      //   "sha384-" + [Convert]::ToBase64String($hash)
      script.integrity =
        "sha384-UwLZGbJGvkTzz0719+xEzUm/idqwzs0yZN8aB9Se5vUXHbyRyDWw9yqZTIsOsJ7x";
      script.crossOrigin = "anonymous";
      script.async = true;

      script.setAttribute("data-repo", wrapper.dataset.giscusRepo || "");
      script.setAttribute("data-repo-id", wrapper.dataset.giscusRepoId || "");
      script.setAttribute(
        "data-category",
        wrapper.dataset.giscusCategory || ""
      );
      script.setAttribute(
        "data-category-id",
        wrapper.dataset.giscusCategoryId || ""
      );
      script.setAttribute(
        "data-mapping",
        wrapper.dataset.giscusMapping || "pathname"
      );
      script.setAttribute("data-strict", "0");
      script.setAttribute(
        "data-reactions-enabled",
        wrapper.dataset.giscusReactionsEnabled || "1"
      );
      script.setAttribute(
        "data-emit-metadata",
        wrapper.dataset.giscusEmitMetadata || "0"
      );
      script.setAttribute(
        "data-input-position",
        wrapper.dataset.giscusInputPosition || "bottom"
      );
      script.setAttribute("data-theme", initialThemeUrl);
      script.setAttribute("data-lang", wrapper.dataset.giscusLang || "en");
      script.setAttribute(
        "data-loading",
        wrapper.dataset.giscusLoading || "lazy"
      );

      wrapper.appendChild(script);
    }

    // Bi-directional message synchronization with the Giscus iframe.
    // Guarded so Astro View Transitions don't stack duplicate listeners.
    if (!window.handleGiscusMessage) {
      window.handleGiscusMessage = function (event) {
        if (event.origin !== "https://giscus.app") return;
        if (event.data && typeof event.data === "object" && event.data.giscus) {
          if (event.data.giscus.discussion || event.data.giscus.viewer) {
            updateGiscusTheme();
          }
        }
      };
      window.addEventListener("message", window.handleGiscusMessage);
    }

    // Listen to theme toggle changes triggered by public/toggle-theme.js
    if (window.handleGiscusThemeChange) {
      document.removeEventListener(
        "theme-changed",
        window.handleGiscusThemeChange
      );
    }
    window.handleGiscusThemeChange = function (e) {
      const theme =
        e && e.detail && e.detail.theme ? e.detail.theme : getCurrentTheme();
      updateGiscusTheme(theme);
    };
    document.addEventListener("theme-changed", window.handleGiscusThemeChange);

    // Performance: initialize via IntersectionObserver 200px before scrolling into view
    const wrapper = document.querySelector(".giscus-wrapper");
    if (wrapper) {
      const observer = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              loadGiscus();
              observer.disconnect();
            }
          });
        },
        { rootMargin: "200px" }
      );
      observer.observe(wrapper);

      // Apply theme as soon as the iframe completes DOM insertion
      const giscusContainer = wrapper.querySelector(".giscus");
      if (giscusContainer) {
        const mutationObserver = new MutationObserver(function (mutations) {
          mutations.forEach(function (mutation) {
            if (
              mutation.addedNodes.length > 0 &&
              mutation.addedNodes[0].tagName === "IFRAME" &&
              mutation.addedNodes[0].classList.contains("giscus-frame")
            ) {
              const iframe = mutation.addedNodes[0];
              iframe.addEventListener("load", function () {
                setTimeout(updateGiscusTheme, 120);
              });
              mutationObserver.disconnect();
            }
          });
        });
        mutationObserver.observe(giscusContainer, { childList: true });
      }
    }
  })();
</script>

<style>
  .giscus-wrapper {
    width: 100%;
    margin-top: 2rem;
  }
  .giscus-wrapper :global(.giscus-frame) {
    width: 100%;
    border: none;
  }
</style>

---
import { GISCUS } from "@/config";
// ?url imports emit fingerprinted files (cache-busting on every edit) and
// resolve to their public URLs. Fingerprinting matters here: giscus.app and
// edge CDNs cache theme CSS aggressively, so a content hash in the filename
// is the only reliable invalidation when the theme changes.
import giscusDarkUrl from "@/assets/giscus-dark.css?url";
import giscusLightUrl from "@/assets/giscus-light.css?url";

export interface Props {
  locale?: string;
}

const isEnabled =
  GISCUS.enabled && !!GISCUS.repo && !!GISCUS.repoId && !!GISCUS.categoryId;

const { locale = "en" } = Astro.props;

// Giscus does not support all languages (e.g. Georgian 'ka').
// Passing an unsupported lang causes the Giscus iframe to 404 and triggers a CSP block.
// Fall back to 'en' for any locale not in the supported set.
const SUPPORTED_GISCUS_LANGS = new Set([
  "ar",
  "ca",
  "de",
  "en",
  "es",
  "fa",
  "fr",
  "he",
  "hu",
  "id",
  "it",
  "ja",
  "kh",
  "ko",
  "nl",
  "pl",
  "pt",
  "ro",
  "ru",
  "th",
  "tr",
  "uk",
  "vi",
  "zh-CN",
  "zh-TW",
]);

const giscusLang = SUPPORTED_GISCUS_LANGS.has(locale) ? locale : "en";
---

{isEnabled && (
  <div
    class="giscus-wrapper"
    data-giscus-repo={GISCUS.repo}
    data-giscus-repo-id={GISCUS.repoId}
    data-giscus-category={GISCUS.category}
    data-giscus-category-id={GISCUS.categoryId}
    data-giscus-mapping={GISCUS.mapping}
    data-giscus-reactions-enabled={GISCUS.reactionsEnabled ? "1" : "0"}
    data-giscus-emit-metadata={GISCUS.emitMetadata ? "1" : "0"}
    data-giscus-input-position={GISCUS.inputPosition}
    data-giscus-lang={giscusLang}
    data-giscus-loading={GISCUS.loading}
    data-giscus-dark-url={giscusDarkUrl}
    data-giscus-light-url={giscusLightUrl}
  >
    <div class="giscus" />
  </div>
)}

<script>
  /**
   * Giscus lazy-loader with theme synchronization.
   *
   * Bundled module (evaluated once per session). Astro's ClientRouter swaps
   * pages without reloading, so all per-page work runs from astro:page-load:
   * starting a session on the home page and then navigating to a post still
   * initializes comments. Everything a page sets up is bound to one
   * AbortController / observer set that astro:before-swap tears down.
   *
   * - Defers ~150KB of JS until the comments section nears the viewport.
   * - No Subresource Integrity on client.js: giscus.app serves it unversioned
   *   and updates it in place, so a pinned hash silently disables comments on
   *   the next upstream release. CSP `script-src https://giscus.app` already
   *   restricts what may load.
   * - Custom theme CSS must be fetchable by giscus.app, which cannot reach a
   *   loopback address. On localhost the built-in light/dark themes are used
   *   instead of guessing production URLs (whose content hash may not exist).
   */
  const GISCUS_ORIGIN = "https://giscus.app";

  type Theme = "light" | "dark";

  let teardown: (() => void) | null = null;

  function getCurrentTheme(): Theme {
    return document.documentElement.dataset.theme === "dark" ? "dark" : "light";
  }

  function isLocalHost(): boolean {
    const { hostname } = window.location;
    return (
      hostname === "localhost" ||
      hostname === "127.0.0.1" ||
      hostname === "[::1]"
    );
  }

  function resolveTheme(wrapper: HTMLElement, theme: Theme): string {
    if (isLocalHost()) return theme;
    const path =
      theme === "dark"
        ? wrapper.dataset.giscusDarkUrl
        : wrapper.dataset.giscusLightUrl;
    return path ? new URL(path, window.location.origin).href : theme;
  }

  function postTheme(wrapper: HTMLElement, theme: Theme = getCurrentTheme()) {
    const iframe = wrapper.querySelector<HTMLIFrameElement>(
      "iframe.giscus-frame"
    );
    iframe?.contentWindow?.postMessage(
      { giscus: { setConfig: { theme: resolveTheme(wrapper, theme) } } },
      GISCUS_ORIGIN
    );
  }

  function injectClient(wrapper: HTMLElement) {
    const d = wrapper.dataset;
    const script = document.createElement("script");
    script.src = `${GISCUS_ORIGIN}/client.js`;
    script.async = true;

    const attrs: Record<string, string> = {
      "data-repo": d.giscusRepo ?? "",
      "data-repo-id": d.giscusRepoId ?? "",
      "data-category": d.giscusCategory ?? "",
      "data-category-id": d.giscusCategoryId ?? "",
      "data-mapping": d.giscusMapping ?? "pathname",
      "data-strict": "0",
      "data-reactions-enabled": d.giscusReactionsEnabled ?? "1",
      "data-emit-metadata": d.giscusEmitMetadata ?? "0",
      "data-input-position": d.giscusInputPosition ?? "bottom",
      "data-theme": resolveTheme(wrapper, getCurrentTheme()),
      "data-lang": d.giscusLang ?? "en",
      "data-loading": d.giscusLoading ?? "lazy",
    };
    for (const [name, value] of Object.entries(attrs)) {
      script.setAttribute(name, value);
    }
    wrapper.appendChild(script);
  }

  function initComments() {
    teardown?.();
    teardown = null;

    const wrapper = document.querySelector<HTMLElement>(".giscus-wrapper");
    if (!wrapper) return;

    const controller = new AbortController();
    const { signal } = controller;

    // Theme toggle (public/toggle-theme.js dispatches "theme-changed")
    document.addEventListener(
      "theme-changed",
      e => {
        const theme = (e as CustomEvent<{ theme?: Theme }>).detail?.theme;
        postTheme(
          wrapper,
          theme === "dark" || theme === "light" ? theme : undefined
        );
      },
      { signal }
    );

    // Re-sync once the iframe reports it is ready
    window.addEventListener(
      "message",
      (event: MessageEvent) => {
        if (event.origin !== GISCUS_ORIGIN) return;
        const data = event.data as { giscus?: Record<string, unknown> } | null;
        if (data?.giscus?.discussion || data?.giscus?.viewer)
          postTheme(wrapper);
      },
      { signal }
    );

    // Load the client ~200px before the section scrolls into view
    const observer = new IntersectionObserver(
      entries => {
        if (entries.some(entry => entry.isIntersecting)) {
          observer.disconnect();
          injectClient(wrapper);
        }
      },
      { rootMargin: "200px" }
    );
    observer.observe(wrapper);

    // Re-apply the theme when the iframe finishes loading, in case the user
    // toggled it while the client was still booting.
    const frameObserver = new MutationObserver(() => {
      const iframe = wrapper.querySelector("iframe.giscus-frame");
      if (!iframe) return;
      frameObserver.disconnect();
      iframe.addEventListener("load", () => postTheme(wrapper), { signal });
    });
    frameObserver.observe(wrapper, { childList: true, subtree: true });

    teardown = () => {
      observer.disconnect();
      frameObserver.disconnect();
      controller.abort();
    };
  }

  document.addEventListener("astro:page-load", initComments);
  document.addEventListener("astro:before-swap", () => {
    teardown?.();
    teardown = null;
  });
</script>

<style>
  .giscus-wrapper {
    width: 100%;
    margin-top: 2rem;
  }
  .giscus-wrapper :global(.giscus-frame) {
    width: 100%;
    border: none;
  }
</style>

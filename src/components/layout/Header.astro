---
// REFACTORED: Header.astro is now a clean, high-level conductor.

import { SITE } from "@/config";
import MobileMenu from "./MobileMenu.astro";
import type { LanguageLink } from "../features/LanguagePicker.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getI18n, type Lang } from "@/i18n";
// NEW: Import constants
import { LANGUAGES, SUPPORTED_LANGS } from "@/i18n/config";

const { pathname } = Astro.url;
// getI18n normalizes an undefined/unknown locale (e.g. the root /404 page,
// which lives outside the /{locale}/ namespace) to the default language.
const { t, lang: locale } = getI18n(Astro.currentLocale as Lang);

// Strip only a leading locale SEGMENT ("/en/..." or "/en"), never a substring.
const localePrefix = new RegExp(`^/(?:${SUPPORTED_LANGS.join("|")})(?=/|$)`);
const pathWithoutLocale = pathname.replace(localePrefix, "");

const otherLanguageLinks: LanguageLink[] = SUPPORTED_LANGS.filter(
  lang => lang !== locale
).map(lang => {
  const path = pathWithoutLocale;
  return {
    code: lang,
    name: LANGUAGES[lang], // Access friendly name from map
    url: getRelativeLocaleUrl(lang, path),
  };
});
---

<header data-testid="site-header">
  <div class="mx-auto flex w-full max-w-app items-center justify-between px-4">
    <nav class="relative flex h-16 w-full items-center justify-between gap-4 border-transparent bg-transparent transition-colors">
      <a
        href={`/${locale}/`}
        class="shrink-0 rounded-md font-sans text-lg font-bold text-foreground no-underline transition-colors hover:text-accent focus:outline-none"
        title={t("nav.home")}
        translate="no"
      >
        {SITE.title}
      </a>

      <div class="flex items-center gap-1 md:gap-4">
        <!-- Mobile Menu Component -->
        <MobileMenu
          currentPath={pathname}
          locale={locale}
          otherLanguageLinks={otherLanguageLinks}
        />
      </div>
    </nav>
  </div>
</header>

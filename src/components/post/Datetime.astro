---
/**
 * Datetime Component
 *
 * Displays publication/modification dates with:
 * - Locale-aware formatting using Intl.DateTimeFormat
 * - Time zone handled by Intl (site zone, or the post's own override)
 * - i18n support for "Updated" label
 */
import IconCalendar from "@/assets/icons/IconCalendar.svg";
import { SITE } from "@/config";
import { getI18n, type Lang } from "@/i18n";
import { formatDate } from "@/utils/i18n/date";

export interface Props {
  class?: string;
  size?: "sm" | "lg";
  timezone?: string;
  pubDatetime: string | Date;
  modDatetime?: string | Date | null;
}

const {
  pubDatetime,
  modDatetime,
  size = "sm",
  class: className = "",
  timezone: postTimezone,
} = Astro.props;

// Get current locale and translations
const currentLocale = (Astro.currentLocale as Lang) ?? "en";
const { t } = getI18n(currentLocale);

const effectiveTimezone = postTimezone ?? SITE.timezone;
const pubDate = new Date(pubDatetime);
const modDate = modDatetime ? new Date(modDatetime) : null;

// Locale-aware, time-zone-correct formatting
// Georgian: "25 დეკ. 2024" | English: "Dec 25, 2024"
const format = (d: Date) =>
  formatDate(d, currentLocale, "short", effectiveTimezone);

// Any later modification (even the same day) counts as an update.
const isModified = !!modDate && modDate > pubDate;

const dateToShow = isModified && modDate ? modDate : pubDate;
const formattedDate = format(dateToShow);
---

<div
  class:list={["flex items-center gap-2", "metadata", className]}
  data-testid="post-datetime"
>
  <IconCalendar
    class:list={["inline-block size-5 min-w-5", { "scale-90": size === "sm" }]}
  />

  {/* Sizing classes live on one parent span to avoid repetition. */}
  <span class:list={["text-sm", { "sm:text-base": size === "lg" }]}>
    {isModified && `${t("post.updated")} `}
    <time datetime={dateToShow.toISOString()}>{formattedDate}</time>
  </span>
</div>

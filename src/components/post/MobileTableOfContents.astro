---
import type { MarkdownHeading } from "astro";
export interface Props {
  headings: MarkdownHeading[];
}
const { headings } = Astro.props;
const toc = headings.filter(h => h.depth >= 2 && h.depth <= 3);
---

{
  toc.length > 0 && (
    <div class="mobile-toc-container mb-8 min-[81rem]:hidden">
      <details
        id="mobile-toc-details"
        class="group rounded-xl border border-border bg-subtle p-3"
      >
        <summary class="flex min-h-[48px] cursor-pointer list-none items-center justify-between px-2 font-semibold text-foreground focus-visible:outline-accent [&::-webkit-details-marker]:hidden">
          <span>On this page</span>
          <span
            class="chevron transition-transform group-open:rotate-90"
            aria-hidden="true"
          >
            ›
          </span>
        </summary>
        <nav class="px-2 pt-3 pb-2" aria-label="Table of contents">
          <ul class="flex flex-col gap-2">
            {toc.map(heading => (
              <li class:list={[{ "ps-4": heading.depth === 3 }]}>
                <a
                  href={`#${heading.slug}`}
                  class="mobile-toc-link block py-2 text-sm text-text-secondary no-underline hover:text-foreground focus-visible:outline-accent"
                >
                  {heading.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </details>
    </div>
  )
}

<script>
  function setupMobileToc() {
    const details = document.getElementById(
      "mobile-toc-details"
    ) as HTMLDetailsElement | null;
    if (!details) return;

    details
      .querySelectorAll<HTMLAnchorElement>(".mobile-toc-link")
      .forEach(link => {
        link.addEventListener("click", event => {
          const href = link.getAttribute("href");
          if (!href?.startsWith("#")) return;

          event.preventDefault();
          const targetId = href.slice(1);
          const targetEl = document.getElementById(targetId);

          if (targetEl) {
            // 1. Close disclosure cleanly
            details.removeAttribute("open");

            // 2. Adjust target scroll margin for sticky header
            const reduceMotion = window.matchMedia(
              "(prefers-reduced-motion: reduce)"
            ).matches;
            targetEl.style.scrollMarginBlockStart = "5rem";
            targetEl.scrollIntoView({
              behavior: reduceMotion ? "auto" : "smooth",
            });

            // 3. Move keyboard focus to destination heading without visual outline
            targetEl.setAttribute("tabindex", "-1");
            targetEl.focus({ preventScroll: true });

            // 4. Update browser history cleanly without double-jump
            history.pushState(null, "", href);
          }
        });
      });
  }
  document.addEventListener("astro:page-load", setupMobileToc);
</script>

---
import Tag from "./Tag.astro";
import ShareLinks from "@/components/features/ShareLinks.astro";
import EditPost from "@/components/features/EditPost.astro";
import BackToTopButton from "@/components/features/BackToTopButton.astro";
import Comments from "@/components/features/Comments.astro";
import IconHash from "@/assets/icons/IconHash.svg";
import IconChevronLeft from "@/assets/icons/IconChevronLeft.svg";
import IconChevronRight from "@/assets/icons/IconChevronRight.svg";
import { slugifyStr } from "@/utils/core";
import { getPostUrl } from "@/utils/post/postUrl";
import { getI18n, type Lang } from "@/i18n";
import { isGiscusConfigured } from "@/config";
import type { CollectionEntry } from "astro:content";

export interface NavigationPost {
  id: string;
  title: string;
  filePath?: string;
}

export interface Props {
  tags: string[];
  showEditPost: boolean;
  editPostConfig: { url: string; text: string };
  post: CollectionEntry<"blog">;
  prevPost?: NavigationPost | null;
  nextPost?: NavigationPost | null;
  tTag: (tag: string) => string;
  locale?: string;
}

const {
  tags,
  showEditPost,
  editPostConfig,
  post,
  prevPost,
  nextPost,
  tTag,
  locale,
} = Astro.props;

// Get translations for the page locale (normalized to a supported language)
const { t, lang } = getI18n((locale ?? Astro.currentLocale) as Lang);

const getPostHref = (p: { id: string }) => getPostUrl(lang, p.id);

// Shared Tailwind Classes (DRY)
const navLinkClasses =
  "group relative flex flex-col gap-1 rounded-2xl border border-border/50 bg-muted/30 p-6 transition-colors motion-reduce:transition-none hover:border-accent/40 hover:bg-muted/40 hover:shadow-sm h-full no-underline";
---

<!--
  base.css gives every section/footer mx-auto, px-4 and a max-width, which
  would inset this block 1rem from the article's left edge. The utilities
  below override that so the landmark can stay a real <footer>.
-->
<footer class="mx-0 mt-12 mb-[clamp(3rem,8vh,6rem)] max-w-none px-0">
  <!-- Topics -->
  {tags.length > 0 && (
    <nav aria-label={t("a11y.postTags")} class="mb-12 space-y-3">
      <div class="flex items-center gap-2 text-xs font-bold tracking-widest text-text-secondary uppercase">
        <IconHash class="size-3.5 opacity-60" /> <span>{t("tags.topics")}</span>
      </div>
      <ul class="flex flex-wrap gap-2">
        {tags.map(tag => (
          <Tag tag={slugifyStr(tag)} tagName={tTag(tag)} />
        ))}
      </ul>
    </nav>
  )}

  <!-- Toolbar -->
  <div class="mb-16 flex flex-col items-center justify-between gap-6 rounded-2xl border border-border/50 bg-muted/30 px-4 py-4 sm:flex-row sm:gap-4 sm:px-6">
    <ShareLinks />
    <div class="flex w-full items-center justify-center gap-4 sm:w-auto sm:justify-end">
      {showEditPost && (
        <EditPost
          href={`${editPostConfig.url}${post.filePath}`}
          text={editPostConfig.text}
        />
      )}
      <BackToTopButton />
    </div>
  </div>

  <!-- Navigation -->
  <nav
    class="grid grid-cols-1 gap-6 sm:grid-cols-2"
    aria-label={t("a11y.postNavigation")}
  >
    {/* Previous Post */}
    {prevPost ? (
      <a href={getPostHref(prevPost)} class={navLinkClasses}>
        <span class="mb-1 flex items-center gap-2 text-xs font-bold tracking-wider text-text-secondary uppercase group-hover:text-accent">
          <IconChevronLeft class="size-3 transition-transform group-hover:-translate-x-1" />{" "}
          {t("nav.previousArticle")}
        </span>
        <span class="line-clamp-3 font-medium text-foreground group-hover:text-accent">
          {prevPost.title}
        </span>
      </a>
    ) : (
      <div />
    )}

    {/* Next Post */}
    {nextPost && (
      <a
        href={getPostHref(nextPost)}
        class={`${navLinkClasses} items-end text-right`}
      >
        <span class="mb-1 flex items-center gap-2 text-xs font-bold tracking-wider text-text-secondary uppercase group-hover:text-accent">
          {t("nav.nextArticle")}{" "}
          <IconChevronRight class="size-3 transition-transform group-hover:translate-x-1" />
        </span>
        <span class="line-clamp-3 font-medium text-foreground group-hover:text-accent">
          {nextPost.title}
        </span>
      </a>
    )}
  </nav>

  <!-- Comments: rendered only when Giscus is configured (no empty heading) -->
  {isGiscusConfigured && (
    <section class="mt-16 px-0" aria-labelledby="comments-heading">
      <h2
        id="comments-heading"
        class="mb-8 flex items-center gap-2 text-xs font-bold tracking-widest text-text-secondary uppercase"
      >
        <IconHash class="size-3.5 opacity-60" aria-hidden="true" />
        <span>{t("comments.discussion")}</span>
      </h2>
      <Comments locale={lang} />
    </section>
  )}
</footer>

---
import { getI18n, type Lang } from "@/i18n";
import { formatDate } from "@/utils/i18n/date";

export interface Props {
  title: string;
  author: string;
  pubDate: Date;
  modDate?: Date | null;
  canonicalUrl: string;
  slug: string;
  locale?: Lang;
}
const { title, author, pubDate, modDate, canonicalUrl, slug, locale } =
  Astro.props;
const { t, lang } = getI18n(locale ?? (Astro.currentLocale as Lang));

const bibtex = `@article{nats_${slug},
  author = {${author}},
  title = {${title}},
  url = {${canonicalUrl}},
  year = {${pubDate.getFullYear()}},
  month = {${pubDate.toLocaleString("en-US", { month: "short", timeZone: "UTC" }).toLowerCase()}}
}`;
---

<div class="provenance-block my-8 rounded-lg border border-border bg-subtle p-4 text-xs text-text-secondary">
  <div class="mb-3 flex flex-wrap justify-between gap-2 border-b border-border pb-3">
    <span>
      {t("post.published")}{" "}
      <time datetime={pubDate.toISOString()}>
        {formatDate(pubDate, lang, "long")}
      </time>
    </span>
    {modDate && (
      <span>
        {t("post.substantialRevision")}{" "}
        <time datetime={modDate.toISOString()}>
          {formatDate(modDate, lang, "long")}
        </time>
      </span>
    )}
  </div>

  <div class="flex items-center justify-between">
    <span class="font-semibold tracking-wider uppercase">
      {t("post.citeThis")}
    </span>
    <button
      type="button"
      class="copy-bibtex-btn rounded border border-border px-2.5 py-1 text-foreground hover:bg-muted focus-visible:outline-accent"
      data-bibtex={bibtex}
      data-copied-label={t("post.copied")}
      aria-live="polite"
    >
      {t("post.copyBibtex")}
    </button>
  </div>
</div>

<script>
  function setupBibtexButtons() {
    document
      .querySelectorAll<HTMLButtonElement>(".copy-bibtex-btn")
      .forEach(btn => {
        btn.addEventListener("click", async () => {
          const text = btn.dataset.bibtex;
          if (!text) return;
          try {
            await navigator.clipboard.writeText(text);
          } catch {
            return;
          }
          const original = btn.textContent;
          btn.textContent = btn.dataset.copiedLabel ?? original;
          setTimeout(() => {
            btn.textContent = original;
          }, 2000);
        });
      });
  }
  document.addEventListener("astro:page-load", setupBibtexButtons);
</script>

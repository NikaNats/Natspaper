---
// src/components/post/TableOfContents.astro
// Left-rail, sticky Table of Contents with ScrollSpy functionality
// rAF-throttled position check (last heading past the reading line)

import type { MarkdownHeading } from "astro";
import { getI18n, type Lang } from "@/i18n";

export interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;
const { t } = getI18n(Astro.currentLocale as Lang);

// Filter: Only top-level headings (h2, h3) to keep the sidebar clean
const toc = headings.filter(h => h.depth >= 2 && h.depth <= 3);
---

{toc.length > 0 && (
  /* Native navigation landmark: implicit navigation role + accessible name.
     (doc-toc is spec-valid DPUB-ARIA, but role tables in older checkers and
     some AT do not expose it; a named <nav> is universally supported.) */
  <nav
    class="toc-nav transition-opacity duration-500"
    aria-label={t("a11y.tableOfContents")}
  >
    <h2 class="mb-4 text-xs font-bold tracking-widest text-text-secondary uppercase opacity-60">
      {t("toc.onThisPage")}
    </h2>
    {/* Wrapper provides the relative positioning context for the indicator */}
    <div class="relative">
      {/* Animated Active Marker — outside <ul> to keep list semantics valid */}
      <div
        id="toc-indicator"
        class="absolute top-0 -left-1 h-6 w-1 rounded-full bg-accent opacity-0 transition-all duration-300 ease-out"
      />
      <ul class="flex flex-col gap-1 border-l border-border/40 text-sm">
        {toc.map(heading => (
          <li class:list={[{ "ml-3": heading.depth === 3 }]}>
            <a
              href={`#${heading.slug}`}
              class:list={[
                // Layout & Typography
                "toc-link block py-1.5 pr-2 pl-4 leading-tight transition-colors duration-200",
                "no-underline", // Explicitly remove global underline style
                // Default State
                "text-text-secondary hover:text-foreground",
                // Hierarchy adjustments
                heading.depth === 3 ? "text-xs" : "text-sm",
              ]}
            >
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>
)}

<script>
  /**
   * ScrollSpy: "the last heading that has scrolled past the reading line".
   *
   * Recomputed from heading positions on each animation frame after a scroll
   * or resize, instead of tracking IntersectionObserver enter events. That
   * makes it correct in the cases an enter-event spy gets wrong:
   * - page load at the top (first heading is active immediately),
   * - scrolling back up, fast jumps, and short sections,
   * - the end of the page (last heading wins once you hit the bottom).
   *
   * Lifecycle: listeners hang off one AbortController per page, aborted on
   * astro:before-swap so nothing accumulates across View Transitions.
   */
  /** Distance from the viewport top (px) at which a heading becomes active. */
  const READING_LINE = 120;

  let controller: AbortController | null = null;

  /** Malformed %-sequences in a hash must not abort the whole spy. */
  function safeDecode(value: string): string {
    try {
      return decodeURIComponent(value);
    } catch {
      return value;
    }
  }

  function teardownScrollSpy() {
    controller?.abort();
    controller = null;
  }

  function initScrollSpy() {
    teardownScrollSpy();

    const nav = document.querySelector(".toc-nav");
    const indicator = document.getElementById("toc-indicator");
    if (!nav) return;

    // Fade in navigation once JS is ready
    nav.classList.remove("opacity-0");

    const tocLinks = new Map<string, HTMLAnchorElement>();
    nav.querySelectorAll<HTMLAnchorElement>(".toc-link").forEach(link => {
      const id = safeDecode(link.hash.slice(1));
      if (id) tocLinks.set(id, link);
    });

    // Only headings that actually have a TOC entry, in document order
    const headings = Array.from(
      document.querySelectorAll<HTMLElement>("article h2[id], article h3[id]")
    ).filter(h => tocLinks.has(h.id));

    if (headings.length === 0) return;

    controller = new AbortController();
    const { signal } = controller;

    let activeHeadingId: string | null = null;
    let frame = 0;

    function computeActiveId(): string {
      const { scrollHeight } = document.documentElement;
      // A page that fits the viewport is "at the bottom" trivially; only treat
      // the end as reached when there is actually somewhere to scroll.
      const isScrollable = scrollHeight - window.innerHeight > 2;
      const scrolledToBottom =
        isScrollable && window.innerHeight + window.scrollY >= scrollHeight - 2;
      if (scrolledToBottom) return headings[headings.length - 1]!.id;

      let current = headings[0]!.id;
      for (const heading of headings) {
        if (heading.getBoundingClientRect().top > READING_LINE) break;
        current = heading.id;
      }
      return current;
    }

    function schedule() {
      if (frame) return;
      frame = requestAnimationFrame(() => {
        frame = 0;
        const next = computeActiveId();
        if (next === activeHeadingId) return;
        activeHeadingId = next;
        updateActiveLink();
      });
    }

    window.addEventListener("scroll", schedule, { passive: true, signal });
    window.addEventListener("resize", schedule, { passive: true, signal });
    signal.addEventListener("abort", () => cancelAnimationFrame(frame));
    schedule();

    function updateActiveLink() {
      if (!activeHeadingId) return;
      tocLinks.forEach((link, id) => {
        const isCurrent = id === activeHeadingId;
        link.classList.toggle("text-accent", isCurrent);
        link.classList.toggle("font-medium", isCurrent);
        if (isCurrent) {
          link.setAttribute("aria-current", "location");
          const listItem = link.closest("li");
          if (listItem instanceof HTMLElement && indicator) {
            indicator.style.opacity = "1";
            indicator.style.top = `${(listItem as HTMLElement).offsetTop}px`;
            indicator.style.height = `${link.getBoundingClientRect().height}px`;
          }
        } else {
          link.removeAttribute("aria-current");
        }
      });
    }
  }
  // Run on initial page load and after View Transitions
  document.addEventListener("astro:page-load", initScrollSpy);
  document.addEventListener("astro:before-swap", teardownScrollSpy);
</script>

<style>
  /* Custom scrollbar for TOC if it gets too long */
  .toc-nav {
    max-height: calc(100vh - 150px);
    overflow-y: auto;
    scrollbar-width: thin;
  }

  .toc-nav::-webkit-scrollbar {
    width: 0.5rem;
  }

  .toc-nav::-webkit-scrollbar-track {
    background: transparent;
  }

  .toc-nav::-webkit-scrollbar-thumb {
    background: var(--color-border);
    opacity: 0.4;
    border-radius: 9999px;
    transition: background-color 200ms;
  }

  .toc-nav::-webkit-scrollbar-thumb:hover {
    background: var(--color-border);
    opacity: 1;
  }
</style>

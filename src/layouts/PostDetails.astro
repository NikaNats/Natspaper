---
// src/layouts/PostDetails.astro
import { render, type CollectionEntry } from "astro:content";
import { SITE, FEATURES } from "@/config";
import { getI18n } from "@/i18n";
import { LOCALE_CODES, type Lang } from "@/i18n/config";
import {
  resolveOgImageUrl,
  getAdjacentPosts,
  getReadingTimeDisplay,
  getPostLocale,
  getPostUrl,
} from "@/utils/post";
import { PostRepository } from "@/utils/post/repository";
import type { BreadcrumbItem } from "@/types";

// Components
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/layout/Header.astro";
import Footer from "@/components/layout/Footer.astro";
import Breadcrumb from "@/components/ui/Breadcrumb.astro";
import PostHero from "@/components/post/PostHero.astro";
import PostContent from "@/components/post/PostContent.astro";
import PostFooter from "@/components/post/PostFooter.astro";
import TableOfContents from "@/components/post/TableOfContents.astro";
import MobileTableOfContents from "@/components/post/MobileTableOfContents.astro";
import SeriesBox from "@/components/post/SeriesBox.astro";
import Bibliography from "@/components/post/Bibliography.astro";

export interface Props {
  post: CollectionEntry<"blog">;
  posts: CollectionEntry<"blog">[];
  isFallback?: boolean;
  originalLocale?: Lang;
}

const { post, posts, isFallback = false, originalLocale } = Astro.props;
const {
  title,
  author,
  description,
  ogImage: initOgImage,
  canonicalURL: frontmatterCanonical,
  pubDatetime,
  modDatetime,
  timezone,
  tags,
  hideEditPost,
} = post.data;

const { Content, headings } = await render(post);

// 1. Data Preparation
// getI18n normalizes an unknown/undefined locale to the default language
const { t, tTag, lang: locale } = getI18n(Astro.currentLocale as Lang);
const readingTimeText = getReadingTimeDisplay(post.body || "", true, locale);

// The language the body is written in (differs from `locale` on fallbacks)
const sourceLocale: Lang =
  getPostLocale(post.id) ?? (isFallback ? originalLocale : undefined) ?? locale;

// Dynamic OG images are keyed by the SOURCE locale of the entry
const ogImage = resolveOgImageUrl(
  initOgImage,
  post.slug,
  Astro.url.origin,
  sourceLocale
);

// 2. Fetch Series Data
const seriesParts = post.data.series
  ? await PostRepository.getSeries(post.data.series.id, locale)
  : [];

// 3. Breadcrumb Navigation Logic
const postsHref = `/${locale}/posts`;
const breadcrumbItems: BreadcrumbItem[] = [
  { label: t("nav.home"), href: `/${locale}` },
  { label: t("nav.posts"), href: postsHref },
];

if (post.data.series) {
  const seriesTitle =
    post.data.series.title.length > 30
      ? post.data.series.title.substring(0, 27) + "..."
      : post.data.series.title;
  breadcrumbItems.push({ label: seriesTitle });
}
breadcrumbItems.push({ label: title });

// 4. Navigation Override (Prev/Next logic)
let { previous: prevPost, next: nextPost } = getAdjacentPosts(posts, post.id);

if (seriesParts.length > 0) {
  const idx = seriesParts.findIndex(p => p.post.id === post.id);
  if (idx > 0 && idx < seriesParts.length) {
    const p = seriesParts[idx - 1]?.post;
    if (p) {
      prevPost = { id: p.id, title: p.data.title, filePath: p.filePath };
    }
  }
  if (idx >= 0 && idx < seriesParts.length - 1) {
    const n = seriesParts[idx + 1]?.post;
    if (n) {
      nextPost = { id: n.id, title: n.data.title, filePath: n.filePath };
    }
  }
}

// 5. Config & Helpers
const editPostConfig = FEATURES.editPost;
const showEditPost = !!(
  editPostConfig.enabled &&
  !hideEditPost &&
  editPostConfig.url
);
const currentYear = new Date().getFullYear();
const copyrightText = `Copyright © ${currentYear} • ${t("footer.copyright")}`;

// 6. Advanced SEO (CreativeWorkSeries)
const seriesSchema = post.data.series
  ? {
      "@type": "CreativeWorkSeries",
      name: post.data.series.title,
      hasPart: seriesParts.map(p => ({
        "@type": "BlogPosting",
        headline: p.post.data.title,
        url: new URL(getPostUrl(locale, p.post.slug), SITE.website).href,
      })),
    }
  : null;

// 7. SEO: Handle Fallback Canonical + decoupled chrome vs body language
const canonicalURL =
  isFallback && originalLocale
    ? new URL(getPostUrl(originalLocale, post.slug), SITE.website).href
    : frontmatterCanonical;

// Chrome language (UI) vs body language (document semantics), as canonical
// BCP 47 tags from the i18n config (single source of truth for new locales).
const contentLang = LOCALE_CODES[sourceLocale];
const docLang = LOCALE_CODES[isFallback ? sourceLocale : locale];
const uiLangTag = LOCALE_CODES[locale];
---

<Layout
  title={title}
  author={author}
  description={description}
  pubDatetime={pubDatetime}
  modDatetime={modDatetime}
  canonicalURL={canonicalURL}
  ogImage={ogImage}
  tags={tags}
  wordCount={post.body?.split(/\s+/).length}
  scrollSmooth
  seriesSchema={seriesSchema}
  noindex={isFallback}
  htmlLang={docLang}
>
  <Header />

  <div class="article-layout">
    <!-- Desktop Sidebar (TOC) -->
    <aside class="article-sidebar" aria-label={t("a11y.tableOfContents")}>
      <div class="article-sidebar__inner">
        <TableOfContents {headings} />
      </div>
    </aside>

    <!-- Main Article Content -->
    <main id="main-content" class="article-container">
      <!-- Breadcrumb Navigation -->
      <Breadcrumb items={breadcrumbItems} class="mb-4" />

      <!-- Language-availability notice: role=note landmark, tagged with the UI locale -->
      {isFallback && (
        <aside
          role="note"
          aria-label={t("a11y.languageNotice")}
          lang={uiLangTag}
          class="fallback-disclaimer mx-auto my-4 mb-8 max-w-app rounded-lg border border-border bg-subtle p-4 text-sm"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="size-5 shrink-0"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="10" />
            <line x1="12" y1="16" x2="12" y2="12" />
            <line x1="12" y1="8" x2="12.01" y2="8" />
          </svg>
          <p class="font-semibold text-foreground">{t("post.fallbackTitle")}</p>
          <p class="mt-1 text-text-secondary">{t("post.fallbackBody")}</p>
        </aside>
      )}

      <PostHero
        slug={post.slug}
        {title}
        {pubDatetime}
        {modDatetime}
        {timezone}
        {readingTimeText}
      />

      <!-- Mobile Table of Contents (mirrors the 84rem rail threshold: no TOC gap) -->
      <div class="block min-[84rem]:hidden">
        <MobileTableOfContents headings={headings} />
      </div>

      {seriesParts.length > 0 && (
        <SeriesBox
          seriesParts={seriesParts}
          currentPostId={post.id}
          locale={locale}
        />
      )}

      <PostContent contentLang={contentLang}>
        <Content />
      </PostContent>

      {post.data.references && post.data.references.length > 0 && (
        <Bibliography references={post.data.references} locale={locale} />
      )}

      <PostFooter
        {tags}
        {showEditPost}
        {editPostConfig}
        {post}
        {prevPost}
        {nextPost}
        {tTag}
        locale={locale}
      />
    </main>
  </div>

  <Footer {copyrightText} />
</Layout>

<style>
  /* Same geometry as the header (max-w-app + px-4) and Main.astro's
     .main-layout--app, so logo, breadcrumb and footer share one left edge.
     px on purpose: max-w-app is px-based and must not scale with root rem. */
  .article-layout {
    position: relative;
    width: min(100%, 768px);
    margin-inline: auto;
    padding-inline: 1rem;
    padding-block: 2rem 3rem;
  }

  .article-container {
    width: 100%;
    min-width: 0;
  }

  .article-sidebar {
    display: none;
  }

  .article-sidebar__inner {
    position: sticky;
    top: calc(var(--header-height, 64px) + 1.5rem);
    opacity: 1;
    transition: opacity 0.2s ease;
  }

  /* Only mount the rail when it fits beside the 768px frame without leaving
     the viewport: 768 + 2 × (rail 252px + gap 27px at the 18px root) ≈ 1326px,
     so 84rem (1344px; media-query rem is always 16px). */
  @media (min-width: 84rem) {
    .article-sidebar {
      display: block;
      position: absolute;
      top: 2rem;
      right: 100%;
      width: var(--rail-width, 14rem);
      height: 100%;
      /* The frame's 1rem padding already separates rail and text */
      margin-right: calc(var(--rail-gap, 2.5rem) - 1rem);
    }
    .article-sidebar__inner {
      position: sticky;
      top: 6rem;
      width: var(--rail-width, 14rem);
      height: fit-content;
      max-height: calc(100vh - 8rem);
      overflow-y: auto;
      overscroll-behavior: contain;
    }
  }

  @media (min-width: 100rem) {
    .article-sidebar {
      width: 16rem;
      margin-right: 4rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .article-sidebar__inner {
      transition: none;
    }
  }
</style>

<script>
  import { featureManager } from "@/utils/features/FeatureManager";

  // Exactly one init/cleanup pair per navigation. astro:page-load fires on
  // the initial load AND after every ClientRouter swap, so listening to
  // astro:after-swap as well initialized every feature twice. Scroll position
  // is owned by the ClientRouter (top on navigation, restored on back).
  //
  // This bundled module stays loaded after the visitor navigates away from a
  // post, so its listeners keep firing on every later page. Post features
  // (progress bar, heading anchors) are therefore gated on the article
  // element (#article, rendered by PostContent) and only torn down if they
  // were actually started.
  let featuresActive = false;

  document.addEventListener("astro:page-load", () => {
    if (!document.getElementById("article")) return;
    featureManager.initializeFeatures();
    featuresActive = true;
  });
  document.addEventListener("astro:before-swap", () => {
    if (!featuresActive) return;
    featureManager.cleanupFeatures();
    featuresActive = false;
  });
</script>

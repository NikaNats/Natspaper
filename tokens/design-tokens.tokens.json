{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "primitive": {
    "color": {
      "$type": "color",
      "blue": {
        "300": {
          "$description": "Dark-theme accent (desaturated for low ambient light).",
          "$extensions": { "com.natspaper.srgb": "#6aadff" },
          "$value": { "colorSpace": "oklch", "components": [0.7379, 0.1379, 254.36] }
        },
        "400": {
          "$description": "Retired 100%-saturation dark accent; kept for reference.",
          "$extensions": { "com.natspaper.srgb": "#4da6ff" },
          "$value": { "colorSpace": "oklch", "components": [0.7112, 0.1559, 250.96] }
        },
        "500": {
          "$extensions": { "com.natspaper.srgb": "#0066ff" },
          "$value": { "colorSpace": "oklch", "components": [0.5635, 0.2408, 260.82] }
        }
      },
      "gray": {
        "50": {
          "$extensions": { "com.natspaper.srgb": "#fafafa" },
          "$value": { "colorSpace": "oklch", "components": [0.9851, 0, 0] }
        },
        "100": {
          "$extensions": { "com.natspaper.srgb": "#f7f7f7" },
          "$value": { "colorSpace": "oklch", "components": [0.9761, 0, 0] }
        },
        "200": {
          "$extensions": { "com.natspaper.srgb": "#e0e0e0" },
          "$value": { "colorSpace": "oklch", "components": [0.9067, 0, 0] }
        },
        "600": {
          "$description": "WCAG 1.4.3: darkened from #757575 for a 4.5:1 contrast ratio on gray-50.",
          "$extensions": { "com.natspaper.srgb": "#595959" },
          "$value": { "colorSpace": "oklch", "components": [0.464, 0, 0] }
        },
        "700": {
          "$description": "WCAG AA fix on the dark theme: lightened for better contrast.",
          "$extensions": { "com.natspaper.srgb": "#b3b3b3" },
          "$value": { "colorSpace": "oklch", "components": [0.7668, 0, 0] }
        },
        "850": {
          "$description": "17% delta vs dark background for visible borders without harshness.",
          "$extensions": { "com.natspaper.srgb": "#333333" },
          "$value": { "colorSpace": "oklch", "components": [0.3211, 0, 0] }
        },
        "900": {
          "$extensions": { "com.natspaper.srgb": "#1e1e1e" },
          "$value": { "colorSpace": "oklch", "components": [0.235, 0, 0] }
        },
        "950": {
          "$description": "Deep dark surface: OLED-safe, avoids harsh pure-black contrast.",
          "$extensions": { "com.natspaper.srgb": "#121212" },
          "$value": { "colorSpace": "oklch", "components": [0.1822, 0, 0] }
        }
      }
    },
    "font": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "Inter",
          "Inter-Fallback",
          "Noto Sans Georgian",
          "Georgian-Fallback",
          "system-ui",
          "sans-serif"
        ]
      },
      "mono": {
        "$value": ["JetBrains Mono", "Mono-Fallback", "ui-monospace", "monospace"]
      }
    },
    "dimension": {
      "$type": "dimension",
      "space": {
        "xs": { "$value": { "value": 0.25, "unit": "rem" } },
        "sm": { "$value": { "value": 0.5, "unit": "rem" } },
        "md": { "$value": { "value": 1, "unit": "rem" } },
        "lg": { "$value": { "value": 1.5, "unit": "rem" } },
        "xl": { "$value": { "value": 2, "unit": "rem" } }
      },
      "radius": {
        "sm": { "$value": { "value": 4, "unit": "px" } },
        "md": { "$value": { "value": 8, "unit": "px" } },
        "full": { "$value": { "value": 9999, "unit": "px" } }
      }
    }
  },
  "semantic": {
    "light": {
      "surface": {
        "$type": "color",
        "background": { "$value": "{primitive.color.gray.50}" },
        "muted": { "$value": "{primitive.color.gray.100}" },
        "border": { "$value": "{primitive.color.gray.200}" },
        "codeBg": {
          "$extensions": { "com.natspaper.srgb": "#f0f0f0" },
          "$value": { "colorSpace": "oklch", "components": [0.9551, 0, 0] }
        }
      },
      "text": {
        "$type": "color",
        "primary": {
          "$extensions": { "com.natspaper.srgb": "#212121" },
          "$value": { "colorSpace": "oklch", "components": [0.2478, 0, 0] }
        },
        "secondary": { "$value": "{primitive.color.gray.600}" }
      },
      "accent": {
        "$type": "color",
        "default": { "$value": "{primitive.color.blue.500}" }
      }
    },
    "dark": {
      "surface": {
        "$type": "color",
        "background": { "$value": "{primitive.color.gray.950}" },
        "muted": { "$value": "{primitive.color.gray.900}" },
        "border": { "$value": "{primitive.color.gray.850}" },
        "codeBg": {
          "$extensions": { "com.natspaper.srgb": "#2a2a2a" },
          "$value": { "colorSpace": "oklch", "components": [0.285, 0, 0] }
        }
      },
      "text": {
        "$type": "color",
        "primary": {
          "$extensions": { "com.natspaper.srgb": "#e0e0e0" },
          "$value": { "colorSpace": "oklch", "components": [0.9067, 0, 0] }
        },
        "secondary": { "$value": "{primitive.color.gray.700}" }
      },
      "accent": {
        "$type": "color",
        "default": {
          "$description": "Desaturated for dark-mode eye comfort (~80% saturation).",
          "$value": "{primitive.color.blue.300}"
        }
      }
    }
  },
  "component": {
    "card": {
      "shadow": {
        "$type": "shadow",
        "$value": {
          "color": {
            "colorSpace": "srgb",
            "components": [0, 0, 0],
            "alpha": 0.05
          },
          "offsetX": { "value": 0, "unit": "px" },
          "offsetY": { "value": 1, "unit": "px" },
          "blur": { "value": 2, "unit": "px" },
          "spread": { "value": 0, "unit": "px" }
        }
      }
    },
    "focusRing": {
      "border": {
        "$type": "border",
        "$value": {
          "color": "{semantic.light.accent.default}",
          "width": { "value": 2, "unit": "px" },
          "style": "solid"
        }
      }
    }
  }
}
